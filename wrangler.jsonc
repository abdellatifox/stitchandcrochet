{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stitchandcrochet",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "html_handling": "drop-trailing-slash"
  },
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "stitchandcrochet.com", "custom_domain": true },
    { "pattern": "www.stitchandcrochet.com", "custom_domain": true }
  ],
  "observability": { "enabled": true },

  // Created with: npx wrangler d1 create stitchandcrochet-db
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stitchandcrochet-db",
      "database_id": "8b37996e-ea3b-43bd-ad6b-d7910b45d75b",
      "migrations_dir": "migrations"
    }
  ],

  // Created with: npx wrangler kv namespace create stitchandcrochet-cache
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "a629f5406e2943049d2dd64f8f898865"
    }
  ]

  // 3) npx wrangler secret put ADMIN_TOKEN   (never commit it)
}
