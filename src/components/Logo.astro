---
import { SITE } from '../lib/site';
---

<a href="/" class="logo" aria-label={`${SITE.name} – home`}>
  <svg class="logo__mark" width="40" height="40" viewBox="0 0 40 40" aria-hidden="true">
    <rect x="1" y="1" width="38" height="38" rx="12" fill="var(--accent-tint)" />
    <!-- a row of chain stitches -->
    <g fill="none" stroke="var(--accent)" stroke-width="2.2">
      <ellipse cx="11" cy="24" rx="4.2" ry="3" />
      <ellipse cx="19.5" cy="24" rx="4.2" ry="3" />
      <ellipse cx="28" cy="24" rx="4.2" ry="3" />
    </g>
    <!-- crochet hook -->
    <path d="M29 7 L12 30" stroke="var(--clay)" stroke-width="2.6" stroke-linecap="round" />
    <path d="M29 7 q3 1 1.4 4" fill="none" stroke="var(--clay)" stroke-width="2.2" stroke-linecap="round" />
  </svg>
  <span class="logo__text">
    <span class="logo__name">Stitch <em>&amp;</em> Crochet</span>
    <span class="logo__domain">stitchandcrochet.com</span>
  </span>
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; min-width: 0; }
  .logo__mark { flex: none; }
  .logo__text { display: grid; line-height: 1.1; }
  .logo__name { font-family: var(--font-head); font-weight: 800; font-size: 1.22rem; color: var(--ink); letter-spacing: -0.01em; white-space: nowrap; }
  .logo__name em { font-weight: 400; color: var(--clay); }
  .logo__domain { font-size: 0.62rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  @media (max-width: 400px) {
    .logo { gap: 8px; }
    .logo__mark { width: 34px; height: 34px; }
    .logo__name { font-size: 1.02rem; }
    .logo__domain { display: none; }
  }
</style>
