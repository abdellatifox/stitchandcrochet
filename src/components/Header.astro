---
import Logo from './Logo.astro';
import { CATEGORIES } from '../lib/site';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="topbar" aria-hidden="true"></div>
  <div class="wrap bar">
    <Logo />

    <div class="tools">
      <nav aria-label="Main" class="nav" id="main-nav">
        <ul class="menu">
          <li><a href="/" aria-current={isActive('/') ? 'page' : undefined}>Home</a></li>
          <li class="has-sub">
            <details>
              <summary class={isActive('/patterns') || isActive('/category') ? 'current' : ''}>Patterns</summary>
              <ul class="sub">
                <li><a href="/patterns">All patterns</a></li>
                {CATEGORIES.map((c) => <li><a href={`/category/${c.slug}`}>{c.name}</a></li>)}
              </ul>
            </details>
          </li>
          <li><a href="/about" aria-current={isActive('/about') ? 'page' : undefined}>About</a></li>
          <li><a href="/contact" aria-current={isActive('/contact') ? 'page' : undefined}>Contact</a></li>
        </ul>
      </nav>

      <a href="/patterns#search" class="icon-btn" aria-label="Search patterns">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      </a>

      <button type="button" class="icon-btn" id="theme-toggle" aria-label="Dark mode" aria-pressed="false" title="Toggle dark mode">
        <svg class="i-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" /></svg>
        <svg class="i-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      </button>

      <button type="button" class="icon-btn menu-btn" id="menu-toggle" aria-controls="main-nav" aria-expanded="false" aria-label="Open menu">
        <svg class="i-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        <svg class="i-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const header = document.querySelector<HTMLElement>('.site-header')!;
  const details = header.querySelector<HTMLDetailsElement>('.has-sub details');
  const menuBtn = header.querySelector<HTMLButtonElement>('#menu-toggle')!;
  const themeBtn = header.querySelector<HTMLButtonElement>('#theme-toggle')!;
  const themeMeta = document.getElementById('theme-color');

  // ----- Theme toggle -----
  function applyTheme(theme: 'light' | 'dark') {
    root.dataset.theme = theme;
    themeBtn.setAttribute('aria-pressed', String(theme === 'dark'));
    themeBtn.setAttribute('aria-label', theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
    themeMeta?.setAttribute('content', theme === 'dark' ? '#1c201e' : '#ffffff');
  }
  applyTheme(root.dataset.theme === 'dark' ? 'dark' : 'light');
  themeBtn.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    applyTheme(next);
    try { localStorage.setItem('theme', next); } catch {}
  });

  // ----- Mobile menu -----
  function setMenu(open: boolean) {
    header.classList.toggle('is-open', open);
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  }
  menuBtn.addEventListener('click', () => setMenu(!header.classList.contains('is-open')));

  // Close dropdown / menu when clicking elsewhere or pressing Escape.
  document.addEventListener('click', (e) => {
    if (!header.contains(e.target as Node)) {
      if (details?.open) details.open = false;
      setMenu(false);
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (details?.open) {
      details.open = false;
      details.querySelector('summary')?.focus();
    } else if (header.classList.contains('is-open')) {
      setMenu(false);
      menuBtn.focus();
    }
  });
</script>

<style>
  .site-header { background: var(--bg); border-bottom: 1px solid var(--line); position: relative; z-index: 20; }
  .topbar { height: 4px; background: linear-gradient(90deg, var(--accent), var(--clay)); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 72px; }
  .tools { display: flex; align-items: center; gap: 4px; }

  .menu { list-style: none; display: flex; align-items: center; gap: clamp(8px, 2.2vw, 28px); margin: 0 12px 0 0; padding: 0; }
  .menu > li > a, summary {
    font-weight: 700; font-size: 0.95rem; color: var(--ink); text-decoration: none;
    padding: 10px 2px; display: inline-flex; align-items: center; gap: 4px; cursor: pointer;
  }
  .menu a[aria-current='page'], summary.current { color: var(--accent-strong); }
  .menu a:hover, summary:hover { color: var(--accent-strong); }
  summary { list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: ''; width: 6px; height: 6px; border: solid currentColor; border-width: 0 2px 2px 0; transform: rotate(45deg) translateY(-2px); margin-left: 4px; }
  .has-sub { position: relative; }
  .sub {
    position: absolute; right: 0; top: calc(100% + 6px); min-width: 210px; list-style: none; margin: 0; padding: 8px;
    background: var(--card); border: 1px solid var(--line); border-radius: var(--radius-sm); box-shadow: var(--shadow);
  }
  .sub a { display: block; padding: 8px 12px; border-radius: 8px; text-decoration: none; color: var(--ink-soft); font-size: 0.95rem; }
  .sub a:hover { background: var(--surface); color: var(--ink); }

  .icon-btn {
    display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: 12px;
    color: var(--ink); background: transparent; border: 0; cursor: pointer; padding: 0;
  }
  .icon-btn:hover { background: var(--surface); color: var(--accent-strong); }
  .i-sun, .i-close, .menu-btn { display: none; }
  :global([data-theme='dark']) .i-sun { display: block; }
  :global([data-theme='dark']) .i-moon { display: none; }

  /* ----- Phones & small tablets: collapsible menu ----- */
  @media (max-width: 760px) {
    .bar { min-height: 64px; }
    .menu-btn { display: inline-grid; }
    .nav {
      display: none; position: absolute; left: 0; right: 0; top: 100%;
      background: var(--bg); border-bottom: 1px solid var(--line); box-shadow: var(--shadow);
      padding: 8px var(--gutter) 16px; max-height: calc(100dvh - 70px); overflow-y: auto;
    }
    .site-header.is-open .nav { display: block; }
    .site-header.is-open .i-open { display: none; }
    .site-header.is-open .i-close { display: block; }
    .menu { flex-direction: column; align-items: stretch; gap: 0; margin: 0; }
    .menu > li { border-bottom: 1px solid var(--line); }
    .menu > li:last-child { border-bottom: 0; }
    .menu > li > a, summary { display: flex; width: 100%; padding: 14px 4px; font-size: 1.05rem; }
    summary { justify-content: space-between; }
    .sub { position: static; box-shadow: none; border: 0; padding: 0 0 10px 8px; min-width: 0; background: transparent; }
    .sub a { padding: 10px 8px; }
  }
  @media (max-width: 400px) {
    .tools { gap: 0; }
    .icon-btn { width: 40px; height: 40px; }
  }
</style>
