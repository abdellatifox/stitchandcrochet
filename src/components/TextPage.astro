---
import Base from '../layouts/Base.astro';

interface Props {
  title: string;
  eyebrow?: string;
  description?: string;
}
const { title, eyebrow, description } = Astro.props;
---

<Base title={title.replace(/\*/g, '')} description={description}>
  <section class="wrap section">
    <div class="page">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 set:html={title.replace(/\*(.+?)\*/g, '<em>$1</em>')} />
      <div class="prose"><slot /></div>
    </div>
  </section>
</Base>

<style>
  .page { max-width: 720px; margin-inline: auto; }
</style>
