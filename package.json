{
  "name": "stitchandcrochet",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply stitchandcrochet-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply stitchandcrochet-db --remote",
    "db:seed:local": "wrangler d1 execute stitchandcrochet-db --local --file=./seed/seed.sql",
    "db:seed:remote": "wrangler d1 execute stitchandcrochet-db --remote --file=./seed/seed.sql",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.0",
    "astro": "^5.13.0",
    "marked": "^16.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "typescript": "^5.8.0",
    "wrangler": "^4.30.0"
  },
  "allowScripts": {
    "esbuild@0.27.0": true,
    "esbuild@0.27.7": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260114.0": true,
    "workerd@1.20260926.1": true,
    "sharp@0.35.4": true,
    "sharp@0.34.5": true
  }
}
